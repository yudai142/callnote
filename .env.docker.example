# Docker 環境用 環境変数テンプレート
# .env にコピーして実際の値を入力してください

# ===== Rails 環境 =====
RAILS_ENV=development

# ===== Database 設定 =====
# Docker Compose の db サービスに接続
DATABASE_URL=postgresql://callnote_user:callnote_password@db:5432/callnote_development

# ===== Redis 設定 =====
# Docker Compose の redis サービスに接続
REDIS_URL=redis://redis:6379

# ===== 外部 API キー =====
# OpenAI Whisper API キー
# https://platform.openai.com/api-keys から取得
OPENAI_API_KEY=sk-placeholder

# Anthropic Claude API キー
# https://console.anthropic.com/account/keys から取得
ANTHROPIC_API_KEY=sk-ant-placeholder

# Groq API キー（音声文字起こし・要約）
# https://console.groq.com/keys から取得
GROQ_API_KEY=gsk_placeholder

# ===== Rails Secret Key Base =====
# 本番環境では必須
# 生成コマンド: openssl rand -hex 64
SECRET_KEY_BASE=

# ===== オプション設定 =====
# ログレベル
RAILS_LOG_LEVEL=debug

# TimeZone
TZ=Asia/Tokyo
