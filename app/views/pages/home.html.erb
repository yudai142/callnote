<% if user_signed_in? %>
  <div id="react-app"></div>
<% else %>
  <div style="display: flex; height: 100vh;">
    <div style="flex: 1; display: flex; align-items: center; justify-content: center; padding: 2rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
      <div style="color: white; max-width: 500px;">
        <h1 style="font-size: 2.5rem; font-weight: bold; margin-bottom: 1rem;">CallNote</h1>
        <p style="font-size: 1.1rem; margin-bottom: 2rem; line-height: 1.6;">
          通話の音声ファイルを簡単に管理し、AI によって自動的に文字起こしと要約を行います。
        </p>
        <div style="display: flex; gap: 1rem;">
          <%= link_to 'ログイン', new_user_session_path, class: 'btn-primary', style: 'padding: 0.75rem 1.5rem; background: white; color: #667eea; border-radius: 0.5rem; text-decoration: none; font-weight: bold; display: inline-block;' %>
          <%= link_to 'サインアップ', new_user_registration_path, class: 'btn-secondary', style: 'padding: 0.75rem 1.5rem; border: 2px solid white; color: white; border-radius: 0.5rem; text-decoration: none; font-weight: bold; display: inline-block;' %>
        </div>
      </div>
    </div>
    <div style="flex: 1; display: flex; align-items: center; justify-content: center; padding: 2rem; background: #f5f5f5;">
      <div style="max-width: 400px;">
        <h2 style="font-size: 1.5rem; font-weight: bold; margin-bottom: 2rem;">主な機能</h2>
        <ul style="list-style: none; padding: 0; margin: 0;">
          <li style="margin-bottom: 1.5rem; display: flex; gap: 1rem;">
            <span style="font-size: 1.5rem;">🎙️</span>
            <div>
              <h3 style="font-weight: bold; margin-bottom: 0.5rem;">音声ファイル管理</h3>
              <p style="color: #666; font-size: 0.9rem;">MP3、WAV などの音声ファイルを安全にアップロード・管理できます。</p>
            </div>
          </li>
          <li style="margin-bottom: 1.5rem; display: flex; gap: 1rem;">
            <span style="font-size: 1.5rem;">✍️</span>
            <div>
              <h3 style="font-weight: bold; margin-bottom: 0.5rem;">自動文字起こし</h3>
              <p style="color: #666; font-size: 0.9rem;">Groq API を使用して、高精度な日本語の文字起こしを自動実行。</p>
            </div>
          </li>
          <li style="display: flex; gap: 1rem;">
            <span style="font-size: 1.5rem;">📝</span>
            <div>
              <h3 style="font-weight: bold; margin-bottom: 0.5rem;">AI 要約</h3>
              <p style="color: #666; font-size: 0.9rem;">通話内容を自動的に要約し、重要なポイントを即座に把握できます。</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
<% end %>
